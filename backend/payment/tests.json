{
  "tests": [
    {
      "name": "Create payment link",
      "method": "POST",
      "body": {
        "order_id": "ORD-001",
        "amount": 999,
        "user_id": "user123"
      },
      "expectedStatus": 200,
      "expectedBody": {
        "payment_id": "string",
        "order_id": "ORD-001",
        "amount": 999,
        "payment_url": "string",
        "status": "pending"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Check payment status",
      "method": "GET",
      "path": "/?payment_id=test-123",
      "expectedStatus": 200,
      "expectedBody": {
        "payment_id": "test-123",
        "status": "string",
        "message": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Missing required fields",
      "method": "POST",
      "body": {
        "order_id": "ORD-001"
      },
      "expectedStatus": 400,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    }
  ]
}